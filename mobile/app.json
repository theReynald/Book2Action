{
  "expo": {
    "name": "Book2Action",
    "slug": "book2action",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "book2action",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a202c"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.book2action.app",
      "buildNumber": "4",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCalendarsUsageDescription": "Book2Action needs access to your calendar to add action step reminders.",
        "NSCalendarsFullAccessUsageDescription": "Book2Action needs access to your calendar to add action step reminders."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a202c"
      },
      "package": "com.book2action.app",
      "versionCode": 1
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": ["expo-router", "expo-secure-store"],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "de7dd0ff-ebe0-4c52-bab5-8f1966aa8308"
      },
      "router": {}
    },
    "owner": "thereynald"
  }
}
